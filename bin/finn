#!/bin/sh
# The one command of Finn Agent. It runs the Agentica programs of this repo with `agentica` (or $AGENTICA), from any
# folder, also through a symlink on PATH.
set -e

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
# -P: the real folder, also when the bin folder itself is a symlink.
root=$(cd -P "$(dirname "$self")/.." && pwd)
agentica=${AGENTICA:-agentica}

# The version of Finn that the server and the clients report: the UTC time of the commit this checkout runs,
# YYYYMMDDhhmmss. Without a .git (an archive of a tag), bin/commit-time holds that time in Unix seconds, which
# `git archive` writes there (export-subst). Empty when neither says: the programs then report "unknown".
commit_version() {
  if [ -e "$root/.git" ]; then
    TZ=UTC0 git -C "$root" log -1 --format=%cd --date=format-local:%Y%m%d%H%M%S 2>/dev/null && return
  fi
  seconds=$(head -n 1 "$root/bin/commit-time" 2>/dev/null) || return 0
  case $seconds in
    ''|*[!0-9]*) return 0 ;;
  esac
  date -u -d "@$seconds" +%Y%m%d%H%M%S 2>/dev/null || date -u -r "$seconds" +%Y%m%d%H%M%S 2>/dev/null || true
}
FINN_VERSION=$(commit_version || true)
export FINN_VERSION

usage() {
  cat <<'TEXT'
usage: finn [tui] [options]       talk to the agent in this folder on the full screen (starts the server when none
                                  runs; needs a terminal; finn tui --help lists the options)
       finn chat [options]        the same as a line chat (finn chat --help lists the options)
       finn -p TASK [--yolo]      one task (- reads it from stdin): the answer on stdout, the rest on stderr
       finn serve [options]       run the server in the foreground
       finn login [PROVIDER]      set up a provider with its key, or local with its base URL: checked, then stored
                                  (pick one when none is given); chatgpt signs in with a code in a browser
       finn logout [PROVIDER]     remove the stored key (or base URL) of a provider, or every stored key and URL
       finn server ACTION         status, start, stop, restart or logs of the server of the state folder
                                  (stop waits for the running turns, --now cancels them; finn server --help)
       finn export SESSION [PATH] the branch a session is on as a Markdown file (0600; default SESSION.md here;
                                  --force replaces a file; finn export --help)
       finn --version | --help

options of finn and finn chat: --provider NAME, --api NAME, --model NAME, --profile NAME (of a new session),
  --session ID, --thinking, --yolo, ... (finn tui --help and finn chat --help list them all)
in chat and tui: /new, /resume, /model, /thinking, /profile, /compact, /export, /login, /logout, /stop, /help,
  /quit
one-shot: approvals (when on) are denied unless --yolo; exit 0 when the turn ends normally (also after a denied call),
  130 when it is cancelled, 1 otherwise (a failed or busy send, an empty task); the server keeps running after it
serve options (each overrides its environment variable):
  --api NAME       model API: openai (chat completions) or openai_responses (default: FINN_API, else openai)
  --provider NAME  provider of new sessions: local, anthropic, a preset with its key set, or one of the config file
                   (default: FINN_PROVIDER)
  --model NAME     default model of new sessions (default: FINN_MODEL)
  --base-url URL   where the model API is (default: FINN_BASE_URL, else http://127.0.0.1:8080/v1)
  --approvals      ask before a tool call that no rule allows (default: FINN_APPROVALS, else "approvals" in the
                   config file; FINN_APPROVALS=0 wins over the file). Off, the model runs any command that no deny
                   rule refuses, without asking: use a sandbox or a container
  --no-codemode    no code mode: the model calls the tools only one by one, not from a Python script (run_script;
                   default: FINN_CODE_MODE, else on where a Monty worker exists)
  (finn serve --help tells the rest: folders, keys, compaction)
TEXT
}

value() {
  [ $# -ge 2 ] || { echo "finn serve: $1 needs a value" >&2; exit 2; }
}

# The options of `serve` set the environment the server reads, as `--name VALUE` or `--name=VALUE`.
serve() {
  while [ $# -gt 0 ]; do
    case $1 in
      --api) value "$@"; export FINN_API="$2"; shift 2 ;;
      --provider) value "$@"; export FINN_PROVIDER="$2"; shift 2 ;;
      --provider=*) export FINN_PROVIDER="${1#*=}"; shift ;;
      --model) value "$@"; export FINN_MODEL="$2"; shift 2 ;;
      --base-url) value "$@"; export FINN_BASE_URL="$2"; shift 2 ;;
      --api=*) export FINN_API="${1#*=}"; shift ;;
      --model=*) export FINN_MODEL="${1#*=}"; shift ;;
      --base-url=*) export FINN_BASE_URL="${1#*=}"; shift ;;
      --approvals) export FINN_APPROVALS=1; shift ;;
      --no-codemode) export FINN_CODE_MODE=0; shift ;;
      -h|--help) exec "$agentica" "$root/core/main.agc" --help ;;
      *) echo "finn serve: unknown option $1" >&2; usage >&2; exit 2 ;;
    esac
  done
  exec "$agentica" "$root/core/main.agc" serve
}

case ${1:-} in
  -h|--help|help) usage ;;
  --version)
    "$agentica" "$root/core/main.agc" --version
    "$agentica" "$root/cli/main.agc" --version
    ;;
  serve) shift; serve "$@" ;;
  chat) shift; exec "$agentica" "$root/cli/main.agc" "$@" ;;
  tui) shift; exec "$agentica" "$root/tui_client/main.agc" "$@" ;;
  export) exec "$agentica" "$root/cli/main.agc" "$@" ;;
  login|logout)
    # A key is never an argument: it is asked for, hidden.
    [ $# -le 2 ] || { echo "finn $1: give the provider alone; the key is asked for next" >&2; exit 2; }
    case $1 in
      login) shift; exec "$agentica" "$root/tui_client/main.agc" --login ${1:+--provider "$1"} ;;
      *) shift; exec "$agentica" "$root/cli/main.agc" --logout "${1:-all}" ;;
    esac
    ;;
  *)
    # The forms of the line client go there (a task, a delete, a logout, a server command or action); the rest opens
    # the full screen, which needs a terminal unless it only prints its help or version. The words after -- are the
    # server command's, and the word after an option that takes one is its value.
    screen=yes
    value=no
    for arg in "$@"; do
      if [ $value = yes ]; then
        value=no
        continue
      fi
      case $arg in
        --) break ;;
        --state-dir|--session|--cwd|--model|--api|--provider) value=yes ;;
        -p*|--prompt|--prompt=*|--delete|--delete=*|--logout|--logout=*|--server-command|--server-command=*|server)
          exec "$agentica" "$root/cli/main.agc" "$@" ;;
        -h|--help|--version) screen=no ;;
      esac
    done
    if [ $screen = yes ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
      echo "finn: the full screen needs a terminal: finn chat is the line chat, finn -p TASK runs one task" >&2
      exit 2
    fi
    exec "$agentica" "$root/tui_client/main.agc" "$@"
    ;;
esac
