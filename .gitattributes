*.agc text eol=lf linguist-language=Ruby
*.feature text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.agcb binary
*.gguf binary
# Recorded fixtures (SSE streams, JSON bodies) are compared byte for byte: no line-ending changes.
**/tests/fixtures/** -text
# Open PRs all add lines under [Unreleased] of a CHANGELOG.md: keep both sides when merging.
CHANGELOG.md merge=union
# The vendored C of tree-sitter and tree-sitter-bash, and the header native-gen makes.
bash/native/runtime/** linguist-vendored
bash/native/grammar/** linguist-vendored -diff
bash/native/bash_native.h linguist-generated
# The commit time of an archive of the repository, for the version that bin/finn reports without a .git.
bin/commit-time export-subst
